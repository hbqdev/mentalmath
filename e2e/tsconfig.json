{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] },
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../src/exercises/**/*.ts", "../src/content/types.ts"]
}
