{
  "name": "mentalmath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ scripts/",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "extract": "tsx scripts/extract-book.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@vueuse/core": "^14.4.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^20.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.5",
    "image-size": "^2.0.4",
    "jiti": "^2.4.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
